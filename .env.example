# =============================================================================
# Gold Market Expert AI - Environment Configuration
# Copy this file to .env and fill in your API keys
# =============================================================================

# -----------------------------------------------
# AI Provider (Required - at least one)
# -----------------------------------------------
# OpenAI API Key (Required for GPT-4o)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (Optional - fallback)
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-key-here

# -----------------------------------------------
# PostgreSQL Database (Required for full features)
# -----------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gold_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------
# VoltAgent Memory Storage (LibSQL/SQLite)
# -----------------------------------------------
# Use file:// for local SQLite, or libsql:// for remote Turso
LIBSQL_URL=file:./.voltagent/memory.db
# LIBSQL_AUTH_TOKEN=your-turso-token  # Only needed for remote Turso

# -----------------------------------------------
# VoltOps Observability (Optional but recommended)
# Get keys: https://console.voltagent.dev/tracing-setup
# -----------------------------------------------
VOLTAGENT_PUBLIC_KEY=
VOLTAGENT_SECRET_KEY=

# -----------------------------------------------
# External Market Data APIs (Optional)
# Tools work with mock data if not provided
# -----------------------------------------------
# Gold/Forex Market Data (e.g., Goldapi.io, MetalpriceAPI)
MARKET_DATA_API_KEY=

# News API (e.g., NewsAPI.org)
NEWS_API_KEY=

# Brave Search (for MCP News integration)
BRAVE_SEARCH_API_KEY=

# -----------------------------------------------
# Application Settings
# -----------------------------------------------
PORT=3141
NODE_ENV=development
LOG_LEVEL=info
